PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/finance-db
JWT_SECRET=your_super_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
NODE_ENV=development
LOG_LEVEL=debug

# --- ArthaGrid 2.0 ---
# Postgres connection string for analytics rollups (e.g. from Neon: https://neon.tech).
# Optional — leave unset and every analytics endpoint just computes live from
# MongoDB instead (see docs/decisions.md #17).
POSTGRES_URL=postgres://<user>:<pass>@<host>/<db>?sslmode=require
# Shared secret the scheduled GitHub Actions rollup job must send (as an
# X-Cron-Secret header) to trigger POST /api/v1/internal/jobs/rollup.
# Make up any long random value — it just needs to match on both sides.
# Required for that endpoint to accept any request at all; otherwise every
# call to it is rejected.
CRON_SECRET=change_me_to_a_long_random_value
# Google Gemini API key for the AI Financial Copilot (free tier: https://aistudio.google.com).
# Optional — leave unset and POST /api/v1/copilot/ask returns 503 instead of
# crashing the server (see docs/decisions.md #19).
GEMINI_API_KEY=your_gemini_api_key
# Which Gemini model to call. Optional — defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# --- ArthaGrid 2.0, not built yet ---
# The frontend's deployed URL (e.g. your Vercel URL), allowed to call this API.
# Leave unset in local development to allow all origins.
CORS_ORIGIN=http://localhost:5173
