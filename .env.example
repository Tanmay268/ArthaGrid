PORT=5000
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/finance-db
JWT_SECRET=your_super_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
NODE_ENV=development
LOG_LEVEL=debug

# --- ArthaGrid 2.0 ---
# Postgres connection string for analytics rollups (e.g. from Neon: https://neon.tech).
# Optional — leave unset and every analytics endpoint just computes live from
# MongoDB instead (see docs/decisions.md #17).
POSTGRES_URL=postgres://<user>:<pass>@<host>/<db>?sslmode=verify-full
# Shared secret the scheduled GitHub Actions rollup job must send (as an
# X-Cron-Secret header) to trigger POST /api/v1/internal/jobs/rollup.
# Make up any long random value — it just needs to match on both sides.
# Required for that endpoint to accept any request at all; otherwise every
# call to it is rejected.
CRON_SECRET=change_me_to_a_long_random_value
# Google Gemini API key for the AI Financial Copilot (free tier: https://aistudio.google.com).
# Optional — leave unset and POST /api/v1/copilot/ask returns 503 instead of
# crashing the server (see docs/decisions.md #19).
GEMINI_API_KEY=your_gemini_api_key
# Which Gemini model to call. Optional — defaults to gemini-3.8-flash if unset.
GEMINI_MODEL=gemini-3.8-flash

# --- Email reports (optional) ---
# Resend (https://resend.com, free tier) sends the weekly report over HTTPS —
# Render's free tier blocks SMTP ports. Leave RESEND_API_KEY unset and the weekly
# job just reports "skipped" (docs/decisions.md #24).
RESEND_API_KEY=re_your_key
# Sender address. Until you verify your own domain in Resend, only its sandbox
# sender works, and only to the account owner's email.
REPORT_FROM_EMAIL=ArthaGrid <onboarding@resend.dev>
# Safety net (comma-separated). When set, ONLY these addresses can ever be emailed —
# registration doesn't verify email ownership, so this stops anyone opting in
# someone else's address.
REPORT_ALLOWED_RECIPIENTS=you@example.com

# --- Metrics & performance (optional) ---
# Bearer token that protects GET /metrics. Unset = /metrics returns 401 to everyone.
METRICS_TOKEN=change_me_to_another_long_random_value
# How long analytics/dashboard responses are cached, in seconds. Default 30; 0 disables.
# (Always off under NODE_ENV=test.) See docs/decisions.md #22.
ANALYTICS_CACHE_TTL_SECONDS=30
# Load testing ONLY: turns the rate limiter off. Ignored when NODE_ENV=production.
# Normally set by `npm run loadtest:server`, not by hand.
# DISABLE_RATE_LIMIT=true

# --- Frontend origin ---
# The frontend's deployed URL (e.g. your Vercel URL), allowed to call this API.
# Leave unset in local development to allow all origins.
CORS_ORIGIN=http://localhost:5173
