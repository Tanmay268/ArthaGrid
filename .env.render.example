# Environment variables to enter in the Render dashboard (see render.yaml and
# docs/deployment.md). Never commit real values.
NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finance-db-prod
JWT_SECRET=replace_with_a_secure_secret_at_least_32_characters_long
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
# Your deployed frontend's URL, exactly (no trailing slash)
CORS_ORIGIN=https://your-frontend.vercel.app
# Long random value; also add it as a GitHub Actions secret named CRON_SECRET
CRON_SECRET=replace_with_a_long_random_value

# Optional
# POSTGRES_URL=postgres://<user>:<pass>@<host>/<db>?sslmode=verify-full
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=
# RESEND_API_KEY=
# REPORT_ALLOWED_RECIPIENTS=you@example.com
# METRICS_TOKEN=
